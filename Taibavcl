local HubName = "BY TÀI BÁ KHÍ HUB"
local MainScriptURL =
    "https://raw.githubusercontent.com/kadit9999/stealanegg/refs/heads/main/ChilliV5BaKhi.lua"
local success, err = pcall(function()
    local source = game:HttpGet(MainScriptURL)
    assert(#source > 0, "Không tải được script")
    local runScript = loadstring(source)
    assert(runScript, "Không thể đọc script")
    runScript()
end)
if not success then
    warn("[" .. HubName .. "] " .. tostring(err))
end
