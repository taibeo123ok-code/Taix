local enabled = false
local saved = {}
local savedEffects = {}
local function saveProperty(obj, property)
    if not saved[obj] then
        saved[obj] = {}
    end
    if saved[obj][property] == nil then
        local ok, value = pcall(function()
            return obj[property]
        end)
        if ok then
            saved[obj][property] = value
        end
    end
end
local function optimizeObject(obj)
    if obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Fire")
        or obj:IsA("Smoke")
        or obj:IsA("Sparkles") then
        saveProperty(obj, "Enabled")
        pcall(function()
            obj.Enabled = false
        end)
    elseif obj:IsA("PostEffect") then
        saveProperty(obj, "Enabled")
        pcall(function()
            obj.Enabled = false
        end)
    elseif obj:IsA("BasePart") then
        saveProperty(obj, "CastShadow")
        pcall(function()
            obj.CastShadow = false
        end)
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        saveProperty(obj, "Transparency")
        pcall(function()
            obj.Transparency = 1
        end)
    end
end
local function setFixLag(state)
    enabled = state
    if enabled then
        saved.GlobalShadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
        for _, obj in ipairs(Workspace:GetDescendants()) do
            optimizeObject(obj)
        end
        for _, obj in ipairs(Lighting:GetChildren()) do
            optimizeObject(obj)
        end
        FixLagButton.Text = "⚡ FIX LAG: ON"
        FixLagButton.BackgroundColor3 =
            Color3.fromRGB(30, 155, 90)
    else
        if saved.GlobalShadows ~= nil then
            Lighting.GlobalShadows = saved.GlobalShadows
        end
        for obj, properties in pairs(saved) do
            if obj and obj.Parent then
                for property, value in pairs(properties) do
                    pcall(function()
                        obj[property] = value
                    end)
                end
            end
        end
        table.clear(saved)
        FixLagButton.Text = "⚡ FIX LAG: OFF"
        FixLagButton.BackgroundColor3 =
            Color3.fromRGB(115, 50, 185)
    end
end
FixLagButton.MouseButton1Click:Connect(function()
    setFixLag(not enabled)
end)

