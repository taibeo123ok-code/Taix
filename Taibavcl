
-- [[ CHILI HUB V5 - MAIN SCRIPT LOADER ]] --

local MainScriptURL =
    "https://raw.githubusercontent.com/kadit9999/stealanegg/refs/heads/main/ChilliV5BaKhi.lua"

local success, result = pcall(function()
    local source = game:HttpGet(MainScriptURL)
    assert(type(source) == "string" and #source > 0, "Script rong")
    local fn = loadstring(source)
    assert(type(fn) == "function", "Khong the nap script")
    return fn()
end)

if not success then
    warn("[CHILI HUB V5] Loi khi tai script: " .. tostring(result))
end
