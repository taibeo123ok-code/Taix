local enabled = false

button.Activated:Connect(function()
    enabled = not enabled

    if enabled then
        -- These settings affect the local experience only
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.Brightness = 2

        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then
                effect.Enabled = false
            end
        end

        button.Text = "OPTIMIZATION ON"
        status.Text = "STATUS: BASIC OPTIMIZATION"
        status.TextColor3 = Color3.fromRGB(100, 255, 160)
    else
        button.Text = "OPTIMIZE LIGHTING"
        status.Text = "STATUS: SETTINGS NOT RESTORED"
        status.TextColor3 = Color3.new(1, 1, 1)
    end
end)

minimized.Activated:Connect(function()
    for _, obj in ipairs(frame:GetChildren()) do
        if obj ~= title and obj ~= minimized
            and obj ~= stroke and obj ~= corner then
            obj.Visible = not obj.Visible
        end
    end
    frame.Size = UDim2.fromOffset(260, 45)
end)

